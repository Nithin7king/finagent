# ─────────────────────────────────────────────
#  FinAgent — Environment Configuration
#  Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# Security — CHANGE THESE in production
SECRET_KEY=super-secret-aes-key-32-characters!!   # must be exactly 32 chars
JWT_SECRET=jwt-super-secret-key-change-me-now
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# LLM Provider: "ollama" (Open Source / Local) | "gemini" | "anthropic" | "offline"
LLM_PROVIDER=ollama

# Ollama Local LLM (Open Source: llama3.1:8b, qwen2.5:7b, mistral, llama3.2, etc.)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Gemini API (https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-1.5-flash

# Anthropic API (https://console.anthropic.com/)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# Database
DATABASE_URL=postgresql://postgres:PSM%40030905@localhost:5432/MYFI.AI

# Vector DB (Chroma)
CHROMA_PERSIST_DIR=./chroma_db

# App
APP_ENV=development
DEBUG=true
